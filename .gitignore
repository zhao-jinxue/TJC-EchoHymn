# ===== 依赖与构建产物 =====
node_modules/
dist/
build/

# Flutter / Dart
.dart_tool/
.packages
.pub/
hymn_app/build/
hymn_app/.dart_tool/
hymn_app/.flutter-plugins
hymn_app/.flutter-plugins-dependencies
hymn_app/.packages
hymn_app/pubspec.lock

# CMake / C++ 构建产物
hymn_app/native/build/
hymn_app/native/cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# IDE 编辑器文件（保留 .vscode/ 中的必要配置）
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea/

# 系统文件
.DS_Store
Thumbs.db
*.log

# 音频与素材（如有本地文件）
audio/
assets/media/

# 诗本下载数据：大文件（音频/PDF/图片）本地缓存不入库，
# 但保留 checksums.json 哈希清单跟踪，使数据变化可通过 git diff 感知
# （参考 hymn_crawler 仓库做法）
data/Hymn_Downloads/**
!data/Hymn_Downloads/**/
!data/Hymn_Downloads/**/*.json

# 爬取断点续跑临时状态（放行 *.json 白名单之后，显式排除）
data/Hymn_Downloads/step2_progress.json
data/Hymn_Downloads/step5_progress.json
data/Hymn_Downloads/step7_progress.json

# SQLite 临时日志（db 运行时的 journal 不应入库）
*.db-journal

# 发布产物（每次 commit 自动重新生成）
release/

# 安装包工程产物（大文件与可再生物，源码脚本正常入库）
installer/payload.7z
installer/staging/
installer/output/
installer/app_icon.ico
